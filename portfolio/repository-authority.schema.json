{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sankarshanmukhopadhyay/trust-infrastructure-schemas/v0.13.0/portfolio/repository-authority.schema.json",
  "title": "Repository Authority Contract",
  "type": "object",
  "required": [
    "repository",
    "authority"
  ],
  "properties": {
    "repository": {
      "type": "string"
    },
    "authority": {
      "type": "object",
      "required": [
        "owns",
        "does_not_own"
      ],
      "properties": {
        "owns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "does_not_own": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
