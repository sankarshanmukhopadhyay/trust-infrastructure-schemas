{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/sankarshanmukhopadhyay/trust-infrastructure-schemas/v0.14.0/credentials/dtg/v1/witness-credential.json",
  "$credentialContext": [
    "https://www.w3.org/ns/credentials/v2",
    "https://firstperson.network/credentials/dtg/v1"
  ],
  "$credentialType": [
    "VerifiableCredential",
    "DTGCredential",
    "WitnessCredential"
  ],
  "title": "VWC (Witness Credential) semantic overlay",
  "description": "DTG witness-credential overlay aligned to dtgwg-cred-spec main as reviewed 2026-08-20. The required digest binds the witness attestation to the exact VRC; taskContext binds it to the trust-task exchange.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "issuer": {
      "type": "string",
      "description": "DID of the witnessing party.",
      "pattern": "^did:[a-z0-9]+:.+$"
    },
    "taskContext": {
      "type": "string",
      "minLength": 1,
      "description": "Trust Task threadId for the exchange in which the witnessing occurred."
    },
    "credentialSubject": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:.+$",
          "description": "DID of the observed party / issuer of the VRC being witnessed."
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Required SHA-256 digest of the JCS-canonicalized witnessed VRC, binding this VWC to that exact directed edge."
        },
        "witnessContext": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "event": {
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "id",
        "digest"
      ]
    }
  },
  "required": [
    "issuer",
    "taskContext",
    "credentialSubject"
  ]
}
