{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sankarshanmukhopadhyay/trust-infrastructure-schemas/v0.13.0/model/tsmm-semantic-coverage.schema.json",
  "title": "TSMM Semantic Coverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverage_id",
    "version",
    "semantic_authority",
    "semantic_authority_version",
    "artifact_contract_authority",
    "coverage"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "coverage_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "semantic_authority": {
      "const": "trust-systems-meta-model"
    },
    "semantic_authority_version": {
      "type": "string"
    },
    "artifact_contract_authority": {
      "const": "trust-infrastructure-schemas"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_id",
          "artifacts",
          "status"
        ],
        "properties": {
          "concept_id": {
            "type": "string",
            "pattern": "^urn:tsmm:concept:"
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "complete",
              "partial",
              "informative",
              "gap"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "unmapped_review_candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:tsmm:concept:"
      }
    }
  }
}
